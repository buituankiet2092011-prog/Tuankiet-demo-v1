-- 5. LÔ GÍC KIỂM TRA ĐỘ HIẾM
local function checkRarityFilter(nameText)
    local str = string.lower(nameText)

    if filterMode == 1 then
        return true
    elseif filterMode == 2 then
        local isTrash = string.find(str, "common") or string.find(str, "uncommon") or string.find(str, "rare") or string.find(str, "thường") or string.find(str, "hiếm")
        local isLegendaryOrBetter = string.find(str, "legendary") or string.find(str, "mythic") or string.find(str, "exotic") or string.find(str, "divine") or string.find(str, "godly") or string.find(str, "celestial") or string.find(str, "secret") or string.find(str, "ancient") or string.find(str, "mutat") or string.find(str, "huyền thoại")
        return isLegendaryOrBetter and not isTrash
    elseif filterMode == 3 then
        return string.find(str, "mutat") or string.find(str, "đột biến")
    end
    return true
end

-- 6. VÒNG LẶP AUTO MUA HẠT (CHẶN HOÀN TOÀN CẢ PHẦN PHÂN BÓN & ĐẤT TRỒNG)
task.spawn(function()
    while task.wait(0.05) do
        if autoBuy then
            pcall(function()
                for _, prompt in pairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        local parent = prompt.Parent
                        local pName = string.lower(parent and parent.Name or "")
                        local parentParentName = string.lower((parent and parent.Parent) and parent.Parent.Name or "")
                        local objText = string.lower(prompt.ObjectText or "")
                        local actionText = string.lower(prompt.ActionText or "")

                        local combinedInfo = pName .. " " .. parentParentName .. " " .. objText .. " " .. actionText

                        -- DANH SÁCH ĐEN MỞ RỘNG (CHẶN PHÂN BÓN, ĐẤT TRỒNG, THỊ TRƯỜNG, TICKET, SHOP, NPC...)
                        local isBlacklisted = 
                            string.find(combinedInfo, "fertiliz") or 
                            string.find(combinedInfo, "compost") or 
                            string.find(combinedInfo, "manure") or 
                            string.find(combinedInfo, "dung") or 
                            string.find(combinedInfo, "soil") or 
                            string.find(combinedInfo, "dirt") or 
                            string.find(combinedInfo, "plot") or 
                            string.find(combinedInfo, "plant") or 
                            string.find(combinedInfo, "ticket") or 
                            string.find(combinedInfo, "market") or 
                            string.find(combinedInfo, "farmer") or 
                            string.find(combinedInfo, "submit") or 
                            string.find(combinedInfo, "exchange") or 
                            string.find(combinedInfo, "trade") or 
                            string.find(combinedInfo, "deliver") or 
                            string.find(combinedInfo, "quest") or 
                            string.find(combinedInfo, "npc") or 
                            string.find(combinedInfo, "talk") or 
                            string.find(combinedInfo, "dialogue") or 
                            string.find(combinedInfo, "merchant") or 
                            string.find(combinedInfo, "shop") or 
                            string.find(combinedInfo, "store") or 
                            string.find(combinedInfo, "pet") or 
                            string.find(combinedInfo, "egg") or 
                            string.find(combinedInfo, "seller") or
                            string.find(combinedInfo, "claim")

                        -- CHỈ CHO PHÉP TƯƠNG TÁC VỚI BĂNG CHUYỀN
                        local isBeltOrSeed = 
                            (string.find(combinedInfo, "seed") or 
                             string.find(combinedInfo, "belt") or 
                             string.find(combinedInfo, "conveyor") or 
                             string.find(combinedInfo, "river") or 
                             string.find(actionText, "grab") or 
                             string.find(actionText, "buy seed") or 
                             string.find(actionText, "take")) and not string.find(combinedInfo, "plant")

                        if not isBlacklisted and isBeltOrSeed then
                            if checkRarityFilter(combinedInfo) then
                                fireproximityprompt(prompt)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

-- 7. TỰ ĐỘNG ĐÓNG MỌI CỬA SỔ POP-UP CHỌN PHÂN BÓN HOẶC GIAO DIỆN TRỒNG CÂY
task.spawn(function()
    local player = game:GetService("Players").LocalPlayer
    while task.wait(0.1) do
        pcall(function()
            local playerGui = player:FindFirstChild("PlayerGui")
            if playerGui then
                for _, gui in pairs(playerGui:GetChildren()) do
                    if gui:IsA("ScreenGui") and gui.Name ~= "TuankietDemo_GreedyGrowers" then
                        for _, element in pairs(gui:GetDescendants()) do
                            if element:IsA("Frame") or element:IsA("ImageLabel") then
                                local eName = string.lower(element.Name)
                                if string.find(eName, "fertiliz") or string.find(eName, "compost") or string.find(eName, "plantmenu") or string.find(eName, "selectseed") then
                                    element.Visible = false
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

