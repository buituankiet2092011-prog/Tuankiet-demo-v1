-- 5. BỘ LỌC THÔNG MINH
local function checkRarityFilter(nameText)
    local str = string.lower(nameText)
    if filterMode == 1 then
        return true
    elseif filterMode == 2 then
        local isTrash = string.find(str, "common") or string.find(str, "uncommon") or string.find(str, "thường") or string.find(str, "bình thường")
        return not isTrash
    elseif filterMode == 3 then
        local isMutated = string.find(str, "mutat") or string.find(str, "đột biến") or string.find(str, "biến dị") or string.find(str, "glitch")
        return isMutated
    end
    return true
end

-- 6. VÒNG LẶP AUTO MUA HẠT (CHỈ TƯƠNG TÁC HẠT ĐƠN VỊ - CHẶN HOÀN TOÀN MUA TẤT CẢ)
task.spawn(function()
    while task.wait(0.1) do
        if autoBuy then
            pcall(function()
                for _, prompt in pairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        local parent = prompt.Parent
                        local pName = string.lower(parent and parent.Name or "")
                        local parentParentName = string.lower((parent and parent.Parent) and parent.Parent.Name or "")
                        local objText = string.lower(prompt.ObjectText or "")
                        local actionText = string.lower(prompt.ActionText or "")

                        local combinedInfo = pName .. " " .. parentParentName .. " " .. objText .. " " .. actionText

                        -- LỌC CỰC MẠNH: NẾU CÓ CHỮ "ALL" (TẤT CẢ) SẼ BỎ QUA NGAY LẬP TỨC
                        if string.find(combinedInfo, "all") or string.find(actionText, "all") or string.find(combinedInfo, "tất cả") or string.find(actionText, "tất cả") then
                            continue -- Chuyển sang prompt tiếp theo, không chạm vào nút này
                        end

                        -- KHÔNG CHẠM VÀO VƯỜN, PHÂN BÓN, HAY CHUỒNG THÚ
                        local isBlacklisted = 
                            string.find(combinedInfo, "fertiliz") or 
                            string.find(combinedInfo, "compost") or 
                            string.find(combinedInfo, "manure") or 
                            string.find(combinedInfo, "soil") or 
                            string.find(combinedInfo, "dirt") or 
                            string.find(combinedInfo, "plot") or 
                            string.find(combinedInfo, "plant") or 
                            string.find(combinedInfo, "garden") or
                            string.find(combinedInfo, "ticket") or 
                            string.find(combinedInfo, "market") or 
                            string.find(combinedInfo, "farmer")

                        -- CHỈ CHO PHÉP MUA HẠT TỪ SHOP HOẶC BĂNG CHUYỀN
                        local isSeedShop = string.find(combinedInfo, "seed") or 
                                           string.find(combinedInfo, "hạt") or 
                                           string.find(combinedInfo, "buy") or 
                                           string.find(combinedInfo, "shop") or
                                           string.find(combinedInfo, "belt") or
                                           string.find(combinedInfo, "conveyor")

                        if not isBlacklisted and isSeedShop then
                            if checkRarityFilter(combinedInfo) then
                                fireproximityprompt(prompt)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

