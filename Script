-- 6. ĐỒ HỌA MINECRAFT (SIÊU THẤP - SMOOTH/BLOCKY)
local isMinecraftGFX = false
LowGFXBtn.MouseButton1Click:Connect(function()
    isMinecraftGFX = not isMinecraftGFX
    if isMinecraftGFX then
        LowGFXBtn.Text = "ĐỒ HỌA MINECRAFT (ĐÃ BẬT)"
        LowGFXBtn.TextColor3 = Color3.fromRGB(0, 255, 127)
        
        local Lighting = game:GetService("Lighting")
        Lighting.GlobalShadows = false
        Lighting.Brightness = 0
        Lighting.FogEnd = 9e9
        
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
                v:Destroy()
            end
        end
        
        -- Chuyển toàn bộ map thành khối chất liệu Plastic phẳng (Phong cách Minecraft)
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.Reflectance = 0
                v.CastShadow = false
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v:Destroy() -- Xóa Texture hình ảnh dán
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") then
                v.Enabled = false
            end
        end
    else
        LowGFXBtn.Text = "ĐỒ HỌA MINECRAFT (0 LAG)"
        LowGFXBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)

-- 7. SPEED WALK LOGIC (0 -> 200)
local currentSpeedIndex = 2
local speedList = {0, 16, 32, 50, 80, 120, 160, 200}

SpeedBtn.MouseButton1Click:Connect(function()
    currentSpeedIndex = currentSpeedIndex + 1
    if currentSpeedIndex > #speedList then currentSpeedIndex = 1 end
    
    local targetSpeed = speedList[currentSpeedIndex]
    SpeedBtn.Text = "SPEED: " .. targetSpeed
    
    local player = game:GetService("Players").LocalPlayer
    if player.Character and player.Character:FindFirstChild("Humanoid") then
        player.Character.Humanoid.WalkSpeed = targetSpeed
    end
end)

