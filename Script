-- 4. CẦU VỒNG RGB ANIMATION
task.spawn(function()
    local hue = 0
    while task.wait(0.03) do
        hue = (hue + 0.005) % 1
        local rainbowColor = Color3.fromHSV(hue, 0.8, 1)
        UIStroke.Color = rainbowColor
        Title.TextColor3 = rainbowColor
    end
end)

