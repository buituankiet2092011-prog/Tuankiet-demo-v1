ServerHopBtn.MouseButton1Click:Connect(function()
    ServerHopBtn.Text = "⏳ Đang tìm server..."
    task.spawn(function()
        pcall(function()
            local servers = {}
            local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
            local data = game:GetService("HttpService"):JSONDecode(req)
            for _, s in pairs(data.data) do
                if s.playing < s.maxPlayers and s.id ~= game.JobId then
                    table.insert(servers, s)
                end
            end
            if #servers > 0 then
                table.sort(servers, function(a, b) return a.playing < b.playing end)
                game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, servers[1].id, LocalPlayer)
            else
                ServerHopBtn.Text = "❌ Không tìm thấy map vắng!"
                task.wait(2)
                ServerHopBtn.Text = "🔍 TÌM MAP VẮNG"
            end
        end)
    end)
end)

local isFixLagActive = false
FixLagBtn.MouseButton1Click:Connect(function()
    isFixLagActive = not isFixLagActive
    FixLagBtn.Text = isFixLagActive and "FIX LAG MÁY YẾU: BẬT" or "FIX LAG MÁY YẾU: TẮT"
    FixLagBtn.TextColor3 = isFixLagActive and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(200, 200, 200)
    
    pcall(function()
        local Lighting = game:GetService("Lighting")
        Lighting.GlobalShadows = not isFixLagActive
        Lighting.Brightness = 1
        
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") then
                v.Enabled = not isFixLagActive
            end
        end
        
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = isFixLagActive and Enum.Material.SmoothPlastic or Enum.Material.Plastic
                obj.CastShadow = false
            elseif obj:IsA("Decal") or obj:IsA("Texture") then
                obj.Transparency = isFixLagActive and 1 or 0
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = not isFixLagActive
            end
        end
    end)
end)

-- THEO DÕI HÀNH ĐỘNG GIEO HẠT CÁ NHÂN
task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            for _, prompt in pairs(workspace:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    local actionText = string.lower(prompt.ActionText or "")
                    local objText = string.lower(prompt.ObjectText or "")
                    if string.find(actionText, "plant") or string.find(actionText, "gieo") or string.find(objText, "plant") or string.find(objText, "seed") then
                        prompt.Triggered:Connect(function(playerWhoTriggered)
                            if playerWhoTriggered == LocalPlayer then
                                hasPlantedThisSession = true
                            end
                        end)
                    end
                end
            end
            
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local rootPos = char.HumanoidRootPart.Position
                for _, item in pairs(workspace:GetDescendants()) do
                    if (item:IsA("Model") or item:IsA("BasePart")) then
                        local pos = item:IsA("BasePart") and item.Position or item:GetPivot().Position
                        if (rootPos - pos).Magnitude < 10 then
                            local n = string.lower(item.Name)
                            if n ~= "humanoidrootpart" and n ~= "head" and n ~= "torso" and n ~= "left arm" and n ~= "right arm" and n ~= "left leg" and n ~= "right leg" and not string.find(n, "part") then
                                hasPlantedThisSession = true
                            end
                        end
                    end
                end
            end
        end)
    end
end)

-- HỆ THỐNG QUÉT SÉT - NHẤP NHÁY CẢNH BÁO 3 LẦN TRƯỚC KHI SÉT ĐÁNH
task.spawn(function()
    local isWarningRunning = false
    while task.wait(0.02) do
        if thunderAlertEnabled and hasPlantedThisSession and not isWarningRunning then
            pcall(function()
                local isThunderIncoming = false
                
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("Sound") then
                        local nameL = string.lower(obj.Name)
                        if (string.find(nameL, "thunder") or string.find(nameL, "lightning") or string.find(nameL, "strike") or string.find(nameL, "storm") or string.find(nameL, "sét") or string.find(nameL, "sấm")) and (obj.IsLoaded or obj.Playing) then
                            isThunderIncoming = true
                            break
                        end
                    end
                    if obj:IsA("BasePart") and obj.Transparency < 0.8 then
                        local nameL = string.lower(obj.Name)
                        if string.find(nameL, "warning") or string.find(nameL, "danger") or string.find(nameL, "target") or string.find(nameL, "zone") or string.find(nameL, "aoe") then
                            isThunderIncoming = true
                            break
                        end
                    end
                end

                if isThunderIncoming then
                    isWarningRunning = true
                    local foundCropName = "NÔNG SẢN"
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local rootPos = char.HumanoidRootPart.Position
                        for _, item in pairs(workspace:GetDescendants()) do
                            if (item:IsA("Model") or item:IsA("BasePart")) then
                                local pos = item:IsA("BasePart") and item.Position or item:GetPivot().Position
                                if (rootPos - pos).Magnitude < 15 then
                                    local n = string.lower(item.Name)
                                    if n ~= "humanoidrootpart" and n ~= "head" and n ~= "torso" and n ~= "left arm" and n ~= "right arm" and n ~= "left leg" and n ~= "right leg" then
                                        foundCropName = string.upper(item.Name)
                                        break
                                    end
                                end
                            end
                        end
                    end

                    WarningLabel.Text = "⚡ " .. string.upper(loggedInUsername) .. " (" .. foundCropName .. "): SÉT SẮP ĐÁNH! LẤY NGAY! ⚡"

                    -- NHẤP NHÁY HIỆN VÀ TẮT ĐÚNG 3 LẦN LIÊN TỤC
                    for i = 1, 3 do
                        WarningLabel.Visible = true
                        task.wait(0.35)
                        WarningLabel.Visible = false
                        task.wait(0.2)
                    end

                    hasPlantedThisSession = false -- Reset trạng thái chờ lượt trồng mới
                    isWarningRunning = false
                end
            end)
        else
            if not hasPlantedThisSession then
                WarningLabel.Visible = false
            end
        end
    end
end)

