-- TẮT HIỆU ỨNG (ULTRA LOW GFX)
local function disableAllEffects(obj)
    if obj:IsA("BasePart") then
        obj.CastShadow = false
        obj.Material = Enum.Material.SmoothPlastic
        obj.Reflectance = 0
        if obj:IsA("MeshPart") then obj.TextureID = "" end
    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Beam") or obj:IsA("Highlight") or obj:IsA("Explosion") then
        obj:Destroy()
    elseif obj:IsA("Texture") or obj:IsA("Decal") then
        obj:Destroy()
    end
end

local isUltraLowActive = false
local connection

LowGFXBtn.MouseButton1Click:Connect(function()
    isUltraLowActive = not isUltraLowActive
    local Lighting = game:GetService("Lighting")
    
    if isUltraLowActive then
        LowGFXBtn.Text = "TẮT HIỆU ỨNG (BẬT)"
        LowGFXBtn.TextColor3 = Color3.fromRGB(0, 255, 127)
        
        Lighting.GlobalShadows = false
        Lighting.Brightness = 1
        Lighting.FogEnd = 9e9
        
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("DepthOfFieldEffect") then 
                v:Destroy() 
            end
        end
        
        for _, v in pairs(workspace:GetDescendants()) do
            disableAllEffects(v)
        end
        
        connection = workspace.DescendantAdded:Connect(disableAllEffects)
    else
        if connection then connection:Disconnect() end
        LowGFXBtn.Text = "TẮT HIỆU ỨNG"
        LowGFXBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)

